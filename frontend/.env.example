# Absolute base URL of the solver backend, once it exists. Leave empty and the
# app runs in its open-a-result-file mode: no network calls, and the "Process
# drawing" button explains that processing is unavailable.
VITE_API_BASE=

# Dev-only: when set, Vite forwards /api to this origin so the browser talks to
# a single origin. Leave unset until there is a backend to point at.
# VITE_PROXY_TARGET=http://localhost:8000
